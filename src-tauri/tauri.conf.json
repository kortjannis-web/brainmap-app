{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainmap",
  "version": "1.0.0",
  "identifier": "de.brainmap.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run dist",
    "beforeDevCommand": "npm run dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brainmap",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "brainmap"
        ],
        "name": "Brainmap-Mindmap",
        "description": "Brainmap-Mindmap",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "startMenuFolder": "Brainmap"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOUIzRTUyNjM2MkRDRDIKUldUUzNHSmpVajZiMEZ2b1M2S3NpeGxSOE43cHpFSHBOS29UQmF3MDE5eFRUcW9BajNobzlaTW8K",
      "endpoints": [
        "https://github.com/kortjannis-web/brainmap-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}